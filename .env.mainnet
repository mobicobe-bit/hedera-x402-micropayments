# =============================================================================
# HEDERA MAINNET CONFIGURATION — COPY TO .env AND FILL IN YOUR VALUES
# =============================================================================
# Treasury: 0.0.4606490 (receives x402 payments + lottery fees)
# Operator: 0.0.4606490 (pays gas fees)
# Get mainnet credentials from https://portal.hedera.com
# USDC mainnet token ID: 0.0.456858 (6 decimals)
# Facilitator: https://x402.org/facilitator (supports mainnet)

# Hedera Mainnet Credentials (REQUIRED - replace with yours)
OPERATOR_ID=0.0.4606490
OPERATOR_KEY=302e020100300506032b65700422042043e878ec8fd4207f0acd43af4332d8ddd667adbcf4d3ddc3e25c4a014ebd3a48

# Treasury account that collects fees (also receives x402 payments)
TREASURY_ID=0.0.4606490
TREASURY_KEY=302e020100300506032b65700422042043e878ec8fd4207f0acd43af4332d8ddd667adbcf4d3ddc3e25c4a014ebd3a48

# Mirror Node (Mainnet)
MIRROR_NODE=https://mainnet.mirrornode.hedera.com

# JSON-RPC Relay (for MetaMask/Hardhat compatibility)
JSON_RPC_URL=https://mainnet.hashio.io/api

# x402 Configuration
# Facilitator URL (Coinbase hosted facilitator - supports mainnet)
X402_FACILITATOR_URL=https://x402.org/facilitator

# Facilitator Hedera account ID (Coinbase default: 0.0.9185802)
X402_FACILITATOR_ADDRESS=0.0.9185802

# Payment receiving address (defaults to TREASURY_ID if not set)
X402_PAY_TO_ADDRESS=0.0.4606490

# Default asset for pricing: hbar | usdc
# RECOMMENDED: usdc (stable, agent-friendly)
X402_DEFAULT_ASSET=usdc

# Pricing in base units (HBAR: tinybars 1e8, USDC: 1e6)
# $0.001 = 1000 base units (for USDC) or 100000000 tinybars (for HBAR)
X402_PRICE_BASIC=1000
X402_PRICE_STANDARD=5000
X402_PRICE_PREMIUM=20000

# Payment timeout (seconds)
X402_MAX_TIMEOUT_SECONDS=300

# Dashboard URL (for webhook callbacks from x402 middleware)
DASHBOARD_URL=https://your-dashboard-domain.com

# Server port
PORT=3001
