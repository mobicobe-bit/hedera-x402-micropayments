# Frontend Environment Variables
# Copy to .env and fill in your values

# Token Configuration (from your deployed token)
VITE_TOKEN_ID=0.0.123456
VITE_TREASURY_ID=0.0.789012
VITE_PRICE_PER_TOKEN_TINYBARS=1000

# WalletConnect Project ID (get from cloud.walletconnect.com)
VITE_WALLETCONNECT_PROJECT_ID=a2f8b8e8c8b8e8c8b8e8c8b8e8c8b8e8

# Backend URL (if not using Vite proxy)
# VITE_BACKEND_URL=http://localhost:3001