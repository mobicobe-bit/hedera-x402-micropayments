# Crypto Micropayments Configuration
# Get credentials from https://portal.hedera.com (or your preferred blockchain network)

# Operator account that pays gas fees
OPERATOR_ID=0.0.1187135
OPERATOR_KEY=0x1a1f1ce0a9bd8810f2cc44458367be411f2389d71c87e0ad4b397c76e42580f5

# Treasury account that collects fees (also receives x402 payments)
TREASURY_ID=0.0.1073622
TREASURY_KEY=302e020100300506032b6570042204201bce7b5fd5bc7f196d9e7fbed33d365b3b6f0f827005b3c35d705a864214a293

# Mirror Node (Testnet or Mainnet)
MIRROR_NODE=https://testnet.mirrornode.hedera.com

# JSON-RPC Relay (for MetaMask/Hardhat compatibility)
JSON_RPC_URL=https://testnet.hashio.io/api

# x402 Configuration
# Facilitator URL (Coinbase hosted facilitator)
X402_FACILITATOR_URL=https://x402.org/facilitator

# Payment receiving address (defaults to TREASURY_ID if not set)
X402_PAY_TO_ADDRESS=0.0.1073622

# Default asset for pricing: hbar | usdc
X402_DEFAULT_ASSET=hbar

# Pricing in base units (HBAR: tinybars 1e8, USDC: 1e6)
# $0.001 = 1000 base units (for USDC) or 100000 tinybars (for HBAR)
X402_PRICE_BASIC=1000
X402_PRICE_STANDARD=5000
X402_PRICE_PREMIUM=20000

# Payment timeout (seconds)
X402_MAX_TIMEOUT_SECONDS=300

# Server port
PORT=3000

# Hedera Agent Kit Configuration (for Week 3 Bounty)
# Network: testnet | mainnet
HEDERA_NETWORK=testnet

# x402 API URL (for agent demo)
X402_API_URL=https://hedera-micropayments-api.mobicobe.workers.dev

# MicroLottery Contract Address (testnet)
LOTTERY_CONTRACT_ADDRESS=0x0e1421ADC7089E9e537c86a4fa8bB07498164DfB

# OpenAI API Key (for LangChain agent demo - optional)
# OPENAI_API_KEY=sk-...
