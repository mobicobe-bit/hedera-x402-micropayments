# Hedera EVM Credentials
# Get testnet credentials from https://portal.hedera.com
# Use the EVM address (0x...) and DER-encoded private key
PRIVATE_KEY=0xYOUR_DER_ENCODED_PRIVATE_KEY

# RPC URLs (Hashio JSON-RPC relays)
HEDERA_TESTNET_RPC=https://testnet.hashio.io/api
HEDERA_MAINNET_RPC=https://mainnet.hashio.io/api

# HashScan API Key for contract verification (optional)
# Get from https://hashscan.io
HASHSCAN_API_KEY=YOUR_HASHSCAN_API_KEY

# Dashboard URL for webhook callbacks (optional)
# Set to your deployed dashboard URL to track lottery fees
DASHBOARD_URL=https://your-dashboard-domain.com

# First round configuration (for create-round.js)
TICKET_PRICE_HBAR=10
PRODUCT_NAME=Wireless Pro Headphones
PRODUCT_DESCRIPTION=Premium noise-cancelling, 40hr battery
PRODUCT_IMAGE_URL=https://example.com/headphones.jpg
DURATION_SECONDS=0